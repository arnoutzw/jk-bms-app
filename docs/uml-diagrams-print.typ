#set document(title: "JK BMS Monitor — UML Diagrams")

// Title page
#page(paper: "a4", margin: 1cm)[
  #align(center + horizon)[
    #text(size: 28pt, weight: "bold")[JK BMS Monitor]
    #v(1em)
    #text(size: 16pt, fill: rgb("#666"))[UML Diagrams]
  ]
]

