%% === Class Diagram ===
classDiagram
    class App {
        +SlotState[] slots
        +number activeSlot
        +string[] PROTOCOLS
        +init()
        +addDevice()
        +removeSlot(idx)
        +render()
        +updateUI()
    }

    class SlotState {
        +number index
        +BluetoothDevice device
        +BluetoothRemoteGATTServer server
        +BluetoothRemoteGATTService service
        +BluetoothRemoteGATTCharacteristic charNotify
        +BluetoothRemoteGATTCharacteristic charWrite
        +Uint8Array rxBuffer
        +string protocolVersion
        +BmsData bmsData
        +boolean connected
        +number reconnectTimer
    }

    class BmsData {
        +number[] cells
        +number[] resistances
        +number[] temps
        +number packVoltage
        +number packCurrent
        +number soc
        +number soh
        +number cycleCount
        +number capacity
        +number balanceCurrent
        +number mosfetTemp
        +boolean chargeEnabled
        +boolean dischargeEnabled
        +number[] alarms
    }

    class BLEConstants {
        <<constants>>
        +UUID SERVICE = 0xFFE0
        +UUID CHAR_NOTIFY = 0xFFE1
        +UUID CHAR_WRITE = 0xFFE2
    }

    class FrameParser {
        +Uint8Array HEADER = 0x55AA_EB90
        +number FRAME_SIZE = 300
        +extractFrames(buffer) Uint8Array[]
        +validateCRC(frame) boolean
        +processFrame(frame, slot)
        +parseDeviceInfo(frame, slot)
        +parseCellData(frame, slot)
    }

    class ProtocolHandler {
        +sendDeviceInfoCmd(slot)
        +sendActivate(slot)
        +sendCommand(slot, cmd)
        +buildCommand(type, data) Uint8Array
    }

    class ChartManager {
        +Chart[] charts
        +number[][] historyData
        +updateChart(slotIdx, bmsData)
        +createChart(canvas, config)
        +pushHistory(slotIdx, data)
    }

    class BSIThemeBridge {
        <<portal integration>>
        +detectTheme()
        +onThemeChange(callback)
    }

    App "1" *-- "3" SlotState : manages up to 3
    SlotState "1" *-- "1" BmsData : contains
    App --> BLEConstants : uses
    App --> FrameParser : uses
    App --> ProtocolHandler : uses
    App --> ChartManager : uses
    App --> BSIThemeBridge : theme sync
    FrameParser --> BmsData : populates
    ProtocolHandler --> SlotState : writes to charWrite


%% === Sequence Diagram — BLE Connection + Data Streaming ===
sequenceDiagram
    participant User
    participant UI as App UI
    participant WB as Web Bluetooth API
    participant Dev as BLE Device (JK BMS)
    participant GATT as GATT Server
    participant Svc as Service 0xFFE0
    participant CN as Char Notify 0xFFE1
    participant CW as Char Write 0xFFE2
    participant FP as FrameParser
    participant Chart as ChartManager

    User->>UI: Click "Add Device"
    activate UI
    UI->>WB: navigator.bluetooth.requestDevice({filters, optionalServices})
    WB-->>User: Device picker dialog
    User->>WB: Select JK BMS device
    WB-->>UI: BluetoothDevice

    UI->>UI: createSlotState(device)
    UI->>UI: connectSlot(slotIdx)
    activate UI
    Note over UI: slot.device = device

    UI->>GATT: device.gatt.connect()
    activate GATT
    GATT-->>UI: BluetoothRemoteGATTServer
    Note over UI: slot.server = server

    UI->>GATT: server.getPrimaryService(0xFFE0)
    GATT->>Svc: Discover service
    Svc-->>GATT: Service handle
    GATT-->>UI: BluetoothRemoteGATTService
    Note over UI: slot.service = service

    UI->>Svc: service.getCharacteristic(0xFFE1)
    Svc->>CN: Discover characteristic
    CN-->>Svc: Characteristic handle
    Svc-->>UI: charNotify reference
    Note over UI: slot.charNotify = charNotify

    UI->>Svc: service.getCharacteristic(0xFFE2)
    Svc->>CW: Discover characteristic
    CW-->>Svc: Characteristic handle
    Svc-->>UI: charWrite reference
    Note over UI: slot.charWrite = charWrite

    UI->>CN: charNotify.startNotifications()
    CN-->>UI: Notifications enabled
    UI->>CN: charNotify.addEventListener("characteristicvaluechanged", onNotification)

    UI->>CW: sendDeviceInfoCmd(slot)
    CW->>Dev: Write device info request command
    Dev-->>CN: Notification: device info frame (partial)
    CN-->>UI: onNotification(event)
    UI->>FP: Append to rxBuffer

    loop Frame assembly (multiple BLE packets)
        Dev-->>CN: Notification: more bytes
        CN-->>UI: onNotification(event)
        UI->>FP: Append to rxBuffer
        FP->>FP: Check for header 0x55AA EB90
        FP->>FP: Check if 300 bytes accumulated
    end

    FP->>FP: extractFrames(rxBuffer)
    FP->>FP: validateCRC(frame)

    alt CRC valid
        FP->>FP: processFrame(frame, slot)
        FP->>FP: Detect protocol version (JK02_24S / JK02_32S / JK04)
        FP-->>UI: slot.protocolVersion set
        FP-->>UI: slot.bmsData populated (device info)
    else CRC invalid
        FP-->>UI: Discard frame, log warning
    end

    UI->>CW: sendActivate(slot)
    CW->>Dev: Write activate command
    Note over Dev: BMS starts streaming cell data
    deactivate UI

    loop Continuous data streaming
        Dev-->>CN: Notification: cell data bytes
        CN-->>UI: onNotification(event)
        UI->>FP: Append to rxBuffer

        loop Frame assembly
            Dev-->>CN: More notification bytes
            CN-->>UI: onNotification
            UI->>FP: Append bytes
        end

        FP->>FP: extractFrames() when 300 bytes ready
        FP->>FP: validateCRC()

        alt Valid cell data frame
            FP->>FP: parseCellData(frame, slot)
            Note over FP: Extract: cells[], resistances[], temps[],<br/>packVoltage, packCurrent, soc, soh,<br/>cycleCount, mosfetTemp, chargeEnabled, etc.
            FP-->>UI: slot.bmsData updated
            UI->>UI: updateUI(slotIdx)
            UI->>Chart: updateChart(slotIdx, bmsData)
            Chart->>Chart: pushHistory(slotIdx, data)
            Chart-->>User: Live charts updated
            UI-->>User: Cell voltages, temps, pack info displayed
        else Invalid frame
            FP-->>UI: Discard, continue
        end
    end

    deactivate UI

    Note over Dev,UI: Disconnect event

    Dev-->>GATT: Connection lost
    deactivate GATT
    GATT-->>UI: gattserverdisconnected event
    UI->>UI: slot.connected = false
    UI-->>User: Show "Disconnected" status

    UI->>UI: Start reconnect timer (3s delay)

    loop Auto-reconnect attempts
        UI->>GATT: device.gatt.connect()
        alt Reconnect success
            GATT-->>UI: Server reconnected
            UI->>UI: Re-discover service + characteristics
            UI->>CW: sendActivate(slot)
            Note over UI: Resume data streaming
        else Reconnect failed
            UI->>UI: Wait 3s, retry
        end
    end


