%% === State Diagram ===
stateDiagram-v2
    [*] --> NoDevices

    state NoDevices {
        [*] --> WaitingForUser
    }

    NoDevices --> Pairing : Click Add Device

    state Pairing {
        [*] --> DevicePicker
        DevicePicker --> SlotCreated : Device selected
        DevicePicker --> NoDevices : Cancelled
    }

    SlotCreated --> Connecting

    state Connecting {
        [*] --> GATTConnect
        GATTConnect --> ServiceDiscovery : GATT connected
        ServiceDiscovery --> CharDiscovery : Service found
        CharDiscovery --> EnableNotifications : Chars found
        EnableNotifications --> RequestDeviceInfo : Notifications on
        RequestDeviceInfo --> AwaitDeviceInfo : Command sent
        AwaitDeviceInfo --> DetectProtocol : Frame received
        DetectProtocol --> Activating : Protocol identified
        Activating --> Streaming : Activate sent
    }

    state Streaming {
        [*] --> ReceivingFrames
        ReceivingFrames --> AssemblingFrame : BLE notification
        AssemblingFrame --> ValidatingCRC : 300 bytes accumulated
        ValidatingCRC --> ParsingData : CRC OK
        ValidatingCRC --> ReceivingFrames : CRC fail (discard)
        ParsingData --> UpdatingUI : Data extracted
        UpdatingUI --> ReceivingFrames : Continue
    }

    Streaming --> Disconnected : BLE disconnect event

    state Disconnected {
        [*] --> WaitingReconnect
        WaitingReconnect --> AttemptingReconnect : 3s timer
        AttemptingReconnect --> WaitingReconnect : Reconnect failed
    }

    Disconnected --> Connecting : Reconnect succeeds
    Disconnected --> NoDevices : User removes slot

    Connecting --> Disconnected : Connection error
